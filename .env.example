# Copy this file to .env (gitignored -- .env is per-machine, never commit it)
# and fill in your own values. docker-compose reads .env automatically.

# Your laptop's WiFi network interface name, used to pin CycloneDDS traffic
# so it reaches the real vehicle (and vice versa) over the shared WiFi
# network instead of a random interface (docker bridge, ethernet, ...).
# Find yours with:
#   ip -br addr
# Pick the "UP" one with an IP on the same WiFi network as the vehicle
# (commonly wlan0, wlp3s0, wlo1, ...). This is NOT the vehicle's own
# interface name (wlP1p1s0) -- every machine has its own.
CYCLONEDDS_NETWORK_INTERFACE=wlan0
